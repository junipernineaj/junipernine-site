---
import Base from '../layouts/Base.astro';

const supporting = [
  {
    href: '/services/incident-management/',
    title: 'Incident management',
    summary: 'Response processes and reviews that stop the same outage happening twice.',
  },
  {
    href: '/services/operational-readiness/',
    title: 'Operational readiness',
    summary: 'Checking a service can be run safely before it goes live, and handed over cleanly.',
  },
  {
    href: '/services/cloud-cost-optimisation/',
    title: 'Cloud cost optimisation',
    summary: 'Finding the waste in a cloud bill and setting the controls that keep it down.',
  },
  {
    href: '/services/observability/',
    title: 'Observability',
    summary: 'Logs, metrics and alerts that tell you something useful, with the noise removed.',
  },
];
---
<Base title="Home" current="">
  <section class="hero">
    <h1>Software tailored to your needs.</h1>
    <p>
      I build and customise tools for both personal and business use, shaped around how you actually
      work. The work draws on years of solving problems, both personally and in a work setting, where
      the available tools didn't quite do what I wanted.
    </p>
    <a class="button" href="/contact/">Describe your project</a>
  </section>

  <section class="home-section">
    <h2>What I build</h2>
    <p>
      Tools for operations teams and personal workflows, built to be understood and changed by the
      people who use them. See the <a href="/services/bespoke-applications/">bespoke applications</a>
      page for how the process works, and the <a href="/apps/">apps</a> page for examples.
    </p>
  </section>

  <section class="home-section">
    <h2>How I help beyond the build</h2>
    <p>
      Alongside the software, I offer consultancy in the operational areas that shape how it should
      be built and run. Each can also be booked on its own.
    </p>
    <div class="service-grid">
      {supporting.map((s) => (
        <div>
          <h3><a href={s.href}>{s.title}</a></h3>
          <p>{s.summary}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
